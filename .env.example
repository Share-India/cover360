# Copy to ".env" (same folder as docker-compose.yml) and fill in. Never commit ".env".

# Long random string used to sign login tokens, e.g. generate with: openssl rand -hex 32
SECRET_KEY=

# AI key used to read policies
GEMINI_API_KEY=
GEMINI_MODEL=

# Public URL of the backend API as the browser sees it. Leave empty to use "<same host>:5000/api".
# Behind a domain / reverse proxy use e.g. https://api.yourdomain.com/api
PUBLIC_API_URL=

# Host ports on the server (only reachable from the server itself; nginx forwards to them).
# Change these if another app already uses 3000 / 5000.
FRONTEND_PORT=3000
BACKEND_PORT=5000
