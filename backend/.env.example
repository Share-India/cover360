FLASK_RUN_PORT=5000
# Use a long random value in production
SECRET_KEY=change-me
# SQLite for local dev, or a MySQL URL
DATABASE_URL=sqlite:///motorai.db
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SMS OTP for sign-up (MSG91). The template text must contain ##OTP##
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Local testing only: print the OTP in the server log instead of sending an SMS
ALLOW_DEV_OTP=false
